__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Working clones of the target repositories. Recreated by `make repos`;
# never committed, because they are large and fully derivable.
data/repos/

# Local secrets never belong in the submission.
.env
*.key

# Repeat-run caches are large and derivable; the primary cache below is committed
# so the reported numbers can be replayed offline.
data/cache/llm_r2/
data/cache/llm_r3/

# Intermediate mining output, superseded by data/cases/mined_all.json.
data/cases/mined.json
data/cases/mined_extra.json
data/cases/mined_sqlglot.json
data/cases/probe.json

# Reviewable bundles emitted by `reprobot.demo --approve`. Derived output, and
# regenerating one is the point of the demo.
proposals/

# Written by `uv run` when borrowing pytest for the harness tests.
uv.lock
