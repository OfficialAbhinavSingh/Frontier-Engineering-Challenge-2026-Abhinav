# Per-repo evaluation environment.
# Deterministic: base image pinned by digest, repo pinned by commit SHA at run time.
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ARG REPO_URL
ARG REPO_NAME
ARG PIN_SHA

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GIT_TERMINAL_PROMPT=0

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
# Full clone: checkouts must work with --network none at run time.
RUN git clone "$REPO_URL" /work/repo
WORKDIR /work/repo
RUN git checkout -q "$PIN_SHA"

# Install the project plus its test tooling once, at image build time.
# Cases only move the checkout within the same dependency generation, so the
# dependency set is identical for every case in a repository -- no case can
# perturb the environment another case is measured in.
RUN pip install --no-cache-dir -e . && pip install --no-cache-dir pytest

# Test-only dependencies live in a different place in every project. Try the
# usual spellings and keep going if one is absent; a missing extra shows up
# later as an honest infra_error on a specific case rather than a silent skip.
RUN for extra in test tests dev testing; do \
        pip install --no-cache-dir -e ".[$extra]" && break || true; \
    done; \
    for req in requirements-tests.txt requirements-test.txt requirements-dev.txt \
               requirements/tests.txt requirements/test.txt requirements/dev.txt \
               tests/requirements.txt; do \
        if [ -f "$req" ]; then pip install --no-cache-dir -r "$req" || true; fi; \
    done; \
    true
